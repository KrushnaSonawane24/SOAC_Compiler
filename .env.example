# Backend Environment
# Copy this to .env and fill in values

# JWT
SOAC_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs (optional)
SOAC_FRONTEND_URL=http://localhost:5173
SOAC_PUBLIC_API_URL=http://127.0.0.1:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
